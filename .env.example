# ── Telegram (obrigatório) ─────────────────────────────────────────────
# token do @BotFather
TELEGRAM_BOT_TOKEN=
# id do grupo, começa com -100 (veja o README)
TELEGRAM_CHAT_ID=

# ── Filtros ────────────────────────────────────────────────────────────
# valor mínimo do claim, em SOL
MIN_CLAIM_SOL=10
# market cap máximo, em USD (500k = 500000)
MAX_MCAP_USD=500000
# opcional: limite em SOL em vez de USD (se preenchido, tem prioridade)
# MAX_MCAP_SOL=

# ── RPC (opcional) ─────────────────────────────────────────────────────
# Sem isso usa o RPC público. Um RPC grátis da Helius deixa o stream mais estável.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=SUA_CHAVE
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=SUA_CHAVE

# ── Comportamento ──────────────────────────────────────────────────────
# silêncio por token depois de um alerta (minutos)
COOLDOWN_MIN=30
# false = ignora claims de tokens já graduados (menos tráfego: ~0,6 MB/s em vez de 1,8)
WATCH_AMM=true
# true = não envia no Telegram, só mostra no console (para testar)
DRY_RUN=false
# desliga sozinho depois de N GB baixados na sessão (0 = sem limite)
MAX_SESSION_GB=0
# manda "ClaimBot online" no grupo quando inicia
STARTUP_MESSAGE=true
# tipos de claim que viram alerta (separados por virgula)
ALERT_TYPES=collect_creator_fee,collect_coin_creator_fee,distribute_creator_fees
# debug | info | warn | error
LOG_LEVEL=info
